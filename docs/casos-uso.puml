  usecase "Gestionar reservas" as UC7
  usecase "Preparar remito" as UC8
  usecase "Despachar remito" as UC9
  usecase "Recibir remito" as UC10
  usecase "Registrar devolución" as UC11
  usecase "Generar remito de retorno" as UC12
