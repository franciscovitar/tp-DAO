@startuml
skinparam classAttributeIconSize 0

class Sede {
  id
  nombre
  direccion
  telefono
  email
  horario
  activa
}

class Socio {
  id
  dni
  nombre
  apellido
  telefono
  email
  habilitado
}

class Libro {
  id
  isbn
  titulo
  autor
  editorial
  anio
}

class Ejemplar {
  id
  codigo
  estado
  estado_fisico
}

class Prestamo {
  id
  fecha_solicitud
  fecha_inicio
  fecha_vencimiento
  fecha_devolucion
  estado
  + esta_vencido()
}

class Reserva {
  id
  fecha
  estado
}

class Remito {
  id
  numero
  fecha_creacion
  fecha_despacho
  fecha_recepcion
  estado
  + cambiar_estado()
}

class HistorialRemito {
  id
  estado
  fecha_hora
}

Libro "1" -- "1..*" Ejemplar
Sede "1" -- "0..*" Ejemplar : pertenencia
Sede "1" -- "0..*" Ejemplar : ubicación actual

Socio "1" -- "0..*" Prestamo
Ejemplar "1" -- "0..*" Prestamo
Sede "1" -- "0..*" Prestamo : origen
Sede "1" -- "0..*" Prestamo : destino

Socio "1" -- "0..*" Reserva
Ejemplar "1" -- "0..*" Reserva
Sede "1" -- "0..*" Reserva

Prestamo "1" -- "0..2" Remito : ida / retorno
Sede "1" -- "0..*" Remito : origen
Sede "1" -- "0..*" Remito : destino
Remito "0..*" -- "1..*" Ejemplar
Remito "1" *-- "1..*" HistorialRemito

note right of Ejemplar
  sede_pertenencia = propietario
  sede_actual = ubicación física
end note

note right of Remito
  PREPARADO
  DESPACHADO
  EN_TRANSITO
  RECIBIDO
end note
@enduml
